TASKHUB_APP_NAME=TaskHub API
TASKHUB_ENVIRONMENT=development
TASKHUB_DEBUG=true
TASKHUB_DATABASE_URL=postgresql+asyncpg://taskhub:taskhub@localhost:5432/taskhub
# Password used only by the PostgreSQL service in compose.yaml; never commit the real value.
TASKHUB_POSTGRES_PASSWORD=replace-with-a-local-postgres-password
# Optional Day 7 cache. Start Redis first, then uncomment this line.
# TASKHUB_REDIS_URL=redis://127.0.0.1:6379/0
TASKHUB_REDIS_TASK_LIST_TTL_SECONDS=60
# JSON list of frontend origins accepted by CORS middleware.
TASKHUB_CORS_ORIGINS=["http://localhost:3000"]
TASKHUB_LOG_LEVEL=INFO
TASKHUB_JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
TASKHUB_JWT_ALGORITHM=HS256
TASKHUB_ACCESS_TOKEN_EXPIRE_MINUTES=30
TASKHUB_REFRESH_TOKEN_EXPIRE_DAYS=7
